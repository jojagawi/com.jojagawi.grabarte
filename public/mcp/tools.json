{
  "name": "InspiraArte",
  "description": "InspiraArte es un taller de corte y grabado láser en Ciudad de México, fundado en 2026, que diseña y produce piezas personalizadas en MDF, acrílico, metal y más. Atiende pedidos desde una pieza hasta pedidos corporativos y envía a todo México. Cada pedido se cotiza y se aprueba con una propuesta de diseño antes de producir.",
  "url": "https://www.inspiraarte.com/",
  "protocol": "webmcp",
  "usage": "Las herramientas se registran en document.modelContext al abrir cualquier página del sitio. Para consultar los datos sin navegador, lee los JSON de /mcp/ que se listan en /llms.txt.",
  "tools": [
    {
      "name": "list_categories",
      "description": "Lista las categorías públicas del catálogo de InspiraArte (taller de corte y grabado láser en CDMX).",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ]
            }
          }
        },
        "required": [
          "categories"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "search_products",
      "description": "Busca productos del catálogo por palabras (nombre, descripción, material o categoría) y/o por categoría. Devuelve nombre, referencia, precio de referencia y enlace.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "description": "Palabras a buscar, por ejemplo \"esferas navidad\" o \"llavero metal\"."
          },
          "category": {
            "type": "string",
            "description": "Nombre de una categoría (ver list_categories)."
          },
          "customizable": {
            "type": "boolean",
            "description": "true para mostrar solo piezas personalizables con nombre, fecha o logo."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Máximo de resultados (1 a 20, 8 por defecto)."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Productos que coinciden (antes de aplicar limit)."
          },
          "exact": {
            "type": "boolean",
            "description": "false si ninguno tiene todas las palabras y se devuelven los más parecidos."
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "ID del producto."
                },
                "idSlug": {
                  "type": "string",
                  "description": "Identificador id-slug de la ficha."
                },
                "reference": {
                  "type": "string",
                  "description": "Referencia IA-0000."
                },
                "name": {
                  "type": "string"
                },
                "categories": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Categorías del producto."
                },
                "suggestedPrice": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Precio de referencia por pieza en MXN; null = bajo cotización."
                },
                "image": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "URL de la imagen principal."
                },
                "url": {
                  "type": "string",
                  "description": "URL absoluta de la ficha."
                }
              },
              "required": [
                "id",
                "reference",
                "name",
                "url"
              ]
            }
          }
        },
        "required": [
          "total",
          "exact",
          "products"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
