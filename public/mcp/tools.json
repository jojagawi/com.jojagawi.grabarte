          },
          "name": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Categorías del producto."
          },
          "suggestedPrice": {
            "type": [
              "number",
              "null"
            ],
            "description": "Precio de referencia por pieza en MXN; null = bajo cotización."
          },
          "image": {
            "type": [
              "string",
              "null"
            ],
            "description": "URL de la imagen principal."
          },
          "url": {
            "type": "string",
            "description": "URL absoluta de la ficha."
          },
          "description": {
            "type": "string"
          },
          "material": {
            "type": [
              "string",
              "null"
            ],
            "description": "MDF, Acrílico, Metal, Termo…"
          },
          "productionTime": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tiempo de producción, por ejemplo \"3 a 4 días hábiles\"."
          },
          "shippingTime": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tiempo de envío."
          },
          "dimensions": {
            "type": [
              "string",
              "null"
            ],
            "description": "Medidas de la pieza."
          },
          "isCustomizable": {
            "type": "boolean",
            "description": "Si se personaliza con nombre, fecha o logo."
          },
          "gallery": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "URLs de imágenes adicionales."
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Nombre del cliente."
                },
                "product": {
                  "type": "string",
                  "description": "Producto que calificó."
                },
                "rating": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "comment": {
                  "type": "string"
                },
                "productId": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "ID del producto, si la calificación está ligada a uno."
                },
                "createdAt": {
                  "type": "string",
                  "description": "Fecha ISO de la calificación."
                }
              },
              "required": [
                "name",
                "rating",
                "comment"
              ]
            },
            "description": "Calificaciones aprobadas del producto."
          }
        },
        "required": [
          "id",
          "reference",
          "name",
          "description",
          "url",
          "reviews"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
