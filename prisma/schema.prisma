// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider = "sqlite"
}

model CatCategories {
  id                   Int                    @id @default(autoincrement())
  name                 String?
  icon                 String?
  // Texto introductorio de la página /productos/categoria/[slug].
  description          String?
  status               Int                    @default(1)
  createdAt            DateTime               @default(now())
  relDesignsCategories RelDesignsCategories[]
  relSeasonsCategories RelSeasonsCategories[]
}

// Temporadas de la vitrina de la portada (/catalogos/temporadas).
// Meses de 1 a 12, inclusivos; startMonth > endMonth cruza el año.
// leadDays: días antes del primer mes en que la temporada empieza a mostrarse.
model CatSeasons {
  id                   Int                    @id @default(autoincrement())
  slug                 String                 @unique
  name                 String
  // Texto introductorio de la página /temporada/[slug].
  description          String?
  startMonth           Int
  endMonth             Int
  leadDays             Int                    @default(21)
  sortOrder            Int                    @default(0)
  // 1 = activa (portada + página), 2 = solo página, 0 = inactiva.
  status               Int                    @default(1)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  relSeasonsCategories RelSeasonsCategories[]
}

model RelSeasonsCategories {
  id         Int           @id @default(autoincrement())
  seasonId   Int
  categoryId Int
  createdAt  DateTime      @default(now())
  season     CatSeasons    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  category   CatCategories @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([seasonId, categoryId])
}

model CatDesignsType {
  id              Int               @id @default(autoincrement())
  name            String?
  status          Int               @default(1)
  createdAt       DateTime          @default(now())
  relDesignsTypes RelDesignsTypes[]
}

model CatFileExtension {
  id        Int      @id @default(autoincrement())
  name      String?
  extension String?
  mimeType  String?
  status    Int      @default(1)
  createdAt DateTime @default(now())
  files     Files[]
}

model CatFileType {
  id          Int      @id @default(autoincrement())
  name        String?
  description String?
  status      Int      @default(1)
  createdAt   DateTime @default(now())
  files       Files[]
}

model CatMaterials {
  id          Int       @id @default(autoincrement())
  name        String?
  status      Int       @default(1)
  createdAt   DateTime  @default(now())
  slug        String?   @unique
  description String?
  icon        String?
  designs     Designs[]
}

model Designs {
  id                   Int                    @id @default(autoincrement())
  name                 String?
  description          String?
  keywords             String?
  seoDescription       String?
  longDescription      String?
  features             String?
  benefits             String?
  useCases             String?
  audience             String?
  faq                  String?
  imageDescription     String?
  productionTime       String?
  shippingTime         String?
  availability         String?
  dimensions           String?
  notes                String?
  author               String?
  status               Int                    @default(1)
  isTested             Int                    @default(0)
  isCustomizable       Int                    @default(0)
  showInHome           Int                    @default(0)
  showInSite           Int                    @default(0)
  createdAt            DateTime               @default(now())
  materialId           Int?
  numberMdfTables      Int                    @default(0)
  timeMachine          Int                    @default(0)
  suggestedPrice       Float?
  mayoreo              Float?
  minimumPrice         Float?
  // Pedidos en HubSpot (negocios distintos con este producto); lo actualiza hubspot:sync-products.
  requests             Int                    @default(0)
  material             CatMaterials?          @relation(fields: [materialId], references: [id])
  relDesignsCategories RelDesignsCategories[]
  relDesignsFiles      RelDesignsFiles[]
  relDesignsTypes      RelDesignsTypes[]
}

model SeoWriterProfiles {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  tone         String
  audience     String?
  defaultMode  String   @default("rewrite-soft")
  instructions String
  status       Int      @default(1)
  isDefault    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Files {
  id              Int               @id @default(autoincrement())
  fileTypeId      Int?
  fileExtensionId Int?
  filePath        String?
  status          Int               @default(1)
  // Si ya se generó la miniatura de este archivo (vistas previas). Columna thumb_generated.
  thumbGenerated  Boolean           @default(false) @map("thumb_generated")
  createdAt       DateTime          @default(now())
  fileType        CatFileType?      @relation(fields: [fileTypeId], references: [id])
  fileExtension   CatFileExtension? @relation(fields: [fileExtensionId], references: [id])
  relDesignsFiles RelDesignsFiles[]
}

model RelDesignsCategories {
  id         Int            @id @default(autoincrement())
  designId   Int?
  categoryId Int?
  status     Int            @default(1)
  createdAt  DateTime       @default(now())
  design     Designs?       @relation(fields: [designId], references: [id])
  category   CatCategories? @relation(fields: [categoryId], references: [id])
}

model RelDesignsFiles {
  id        Int      @id @default(autoincrement())
  designId  Int?
  typeId    Int?
  status    Int      @default(1)
  createdAt DateTime @default(now())
  design    Designs? @relation(fields: [designId], references: [id])
  file      Files?   @relation(fields: [typeId], references: [id])
}

model RelDesignsTypes {
  id         Int             @id @default(autoincrement())
  designId   Int?
  typeId     Int?
  status     Int             @default(1)
  createdAt  DateTime        @default(now())
  design     Designs?        @relation(fields: [designId], references: [id])
  designType CatDesignsType? @relation(fields: [typeId], references: [id])
}

model testimonials {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  content   String
  product   String
  rating    Int
  status    Int      @default(1)
  createdAt DateTime @default(now())
}

model Faqs {
  id         Int    @id @default(autoincrement())
  question   String @unique
  answer     String
  showInSite Int    @default(1)
  showInMcp  Int    @default(1)
  priority   Int    @default(1)
}

// Prompts de IA editables desde Administrar › Prompts de IA. "key" identifica el uso
// (por ejemplo "product-thumbnail"); el texto admite variables {{nombre}}, {{descripcion}}…
model AiPrompts {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  name        String
  description String?
  prompt      String
  model       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Catálogo de modelos de IA (Administrar › Modelos de IA). Reemplaza las listas del
// environment: los selectores del editor usan los habilitados. "Actualizar modelos
// oficiales" sincroniza con Gemini y OpenRouter sin pisar lo editado a mano.
model AiModels {
  id            Int       @id @default(autoincrement())
  // "gemini" | "openrouter"
  provider      String
  // Identificador para la API (gemini-2.5-flash, qwen/qwen2.5-vl-72b-instruct:free…)
  modelId       String
  displayName   String
  description   String?
  inputText     Boolean   @default(true)
  inputImage    Boolean   @default(false)
  outputText    Boolean   @default(true)
  outputImage   Boolean   @default(false)
  // "free" | "free-tier" | "paid" | "unknown"
  pricing       String    @default("unknown")
  // true si se editó en el panel: la sincronización ya no lo cambia.
  pricingManual Boolean   @default(false)
  contextLength Int?
  // Aparece en los selectores del editor.
  isEnabled     Boolean   @default(false)
  // Modelo predeterminado del proveedor para el asistente SEO.
  isDefault     Boolean   @default(false)
  // Sigue en la lista oficial del proveedor (false = ya no se ofrece).
  isAvailable   Boolean   @default(true)
  // "official" (sincronizado) | "manual" (agregado en el panel)
  source        String    @default("official")
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([provider, modelId])
}
