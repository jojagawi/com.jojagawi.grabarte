{
  "name": "inspiraarte.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "run-s build:sw",
    "dev": "next dev",
    "predev:https": "run-s build:sw",
    "dev:https": "next dev --hostname dev.inspiraarte.com --port 3000 --experimental-https --experimental-https-key ./certs/cer.key --experimental-https-cert ./certs/cer.pem",
    "build:sw": "tsc --project tsconfig.sw.json",
    "build:mcp": "tsx scripts/build-mcp-fallback.ts",
    "images:optimize": "node scripts/optimize-images.mjs",
    "prebuild": "run-s build:sw prisma:generate build:mcp images:optimize",
    "postbuild": "run-s build:sitemap",
    "build:all": "run-s prebuild build",
    "build": "next build",
    "prebuild:static": "run-s build:sw prisma:generate build:mcp images:optimize",
    "build:static": "cross-env STATIC_EXPORT=true next build",
    "postbuild:static": "run-s build:sitemap",
    "build:sitemap": "next-sitemap --config next-sitemap.config.cjs",
    "start": "next start",
    "prisma:validate": "npx prisma validate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:reset": "npx prisma migrate reset",
    "prisma:deploy": "npx prisma migrate deploy",
    "prisma:generate": "npx prisma generate",
    "prisma:seed": "npx prisma db seed",
    "pretest:typecheck": "run-s prisma:generate",
    "test:typecheck": "tsc --noEmit",
    "test:lint": "eslint .",
    "test:style:check": "stylelint \"src/**/*.{scss,css}\"",
    "test:style:fix": "stylelint --fix \"src/**/*.{scss,css}\"",
    "test:format:fix": "prettier --write \"src/**/*.{js,jsx,css,scss}\" \"*.{js,json,md}\"",
    "test:format:check": "prettier --check \"src/**/*.{js,jsx,css,scss}\" \"*.{js,json,md}\"",
    "test:lighthouse:raw": "lhci autorun",
    "test:lighthouse": "node scripts/run-lighthouse-stable.mjs",
    "test:all": "run-s test:lint test:style:check test:format:check test:typecheck",
    "ci": "run-s test:all build test:lighthouse"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@hookform/resolvers": "^3.9.1",
    "@mcp-b/webmcp-polyfill": "^4.0.0",
    "@next/third-parties": "^16.2.11",
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@react-icons/all-files": "^4.1.0",
    "@vercel/analytics": "1.6.1",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^13.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "4.1.0",
    "dxf-viewer": "^1.0.48",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lbrn2-to-svg": "^0.5.3",
    "lucide-react": "^0.564.0",
    "next": "16.3.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.1.200",
    "react": "19",
    "react-day-picker": "10.0.1",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "react-pdf": "^10.4.1",
    "react-resizable-panels": "^2.1.7",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.23.1",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-compat": "^4.0.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "next-llms-txt": "~1.0.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5",
    "prettier": "^3.9.5",
    "prisma": "^7.9.0",
    "prisma-dbml-generator": "^0.12.0",
    "sharp": "^0.34.4",
    "stylelint": "^17.14.0",
    "stylelint-browser-compat": "^1.0.0-beta.180",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "stylelint-no-unsupported-browser-features": "^8.0.5",
    "tailwindcss": "^4",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  }
}
